# =============================================================================
# bookingConcurrent — environment configuration
#
# Copy to `.env` and adjust. NEVER commit real values (.gitignore excludes .env).
# Every variable here is loaded and VALIDATED at boot by internal/platform/config:
# the process refuses to start if anything required is missing or malformed —
# a broken process must never look like a healthy one (CLAUDE.md §10).
#
# The Makefile sources this file for `make run`, so keep it to plain
# KEY=value lines (no shell tricks, no inline comments on value lines).
# =============================================================================

# Deployment environment: development | production | test
#   development: human-readable logs, auto-migrations at boot
#   production:  JSON logs, stricter secret validation
#   test:        reserved for the test suite
ENV=development

# Name stamped on logs/traces/metrics so this service is findable in Jaeger.
# `make run-worker` overrides this inline to booking-worker — one shared
# .env cannot express per-binary names, and distinct names keep the two
# processes apart in logs and traces.
SERVICE_NAME=booking-api

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
# How long to wait for in-flight requests to drain on SIGTERM/SIGINT
# before forcing the server closed (graceful shutdown, CLAUDE.md §5).
HTTP_SHUTDOWN_TIMEOUT=15s

# Exact browser origins, comma-separated, without trailing slash or wildcard.
# Empty = reject every request carrying Origin (including same-origin POST).
# List the API's own origin too for a same-origin browser deployment.
# CLI clients/webhooks without Origin continue normally. Example SPA:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOWED_ORIGINS=

# Per-IP token buckets in ONE API process (ADR 0011). RPM is continuous
# refill per minute, BURST is the initial/max capacity. General applies to
# all requests except GET/HEAD healthz/readyz/metrics and CORS-terminated requests.
# POST register/login/refresh/logout share the auth quota; POST /holds has
# its own quota. Both also consume general quota. Rejections return 429.
RATE_LIMIT_GENERAL_RPM=120
RATE_LIMIT_GENERAL_BURST=30
RATE_LIMIT_AUTH_RPM=10
RATE_LIMIT_AUTH_BURST=5
RATE_LIMIT_HOLD_RPM=30
RATE_LIMIT_HOLD_BURST=5
# Bound memory; when full, reject new IPs rather than evict active quotas.
RATE_LIMIT_MAX_CLIENTS=10000
# Idle eviction must be >= max(BURST/RPM minutes) across all three policies.
RATE_LIMIT_IDLE_TTL=10m
# Identity comes ONLY from the connection's RemoteAddr. Forwarded headers
# are ignored. Behind a proxy, clients share its quota: enforce per-client
# limits at that trusted edge. State resets on restart and is per replica.

# -----------------------------------------------------------------------------
# Logging: debug | info | warn | error
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Redis — TRANSIENT concurrency state only: seat holds (SET NX + TTL) and
# session reverse-lookup keys. Nothing durable may live here (see ADR 0003).
# -----------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# How long a seat hold lives before it expires on its own.
REDIS_HOLD_TTL=5m

# -----------------------------------------------------------------------------
# Booking policy
# -----------------------------------------------------------------------------
# Max seats one user may hold simultaneously. Enforced atomically inside the
# Redis hold script (a check-then-act from Go would be advisory under load).
MAX_ACTIVE_HOLDS=4

# -----------------------------------------------------------------------------
# PostgreSQL — the durable source of truth: users, movies, screenings,
# confirmed bookings, payments, outbox, refresh tokens, audit log.
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
# 5433: the compose stack maps its container to host port 5433 because a
# local host Postgres commonly owns 5432 already (see compose.yaml).
POSTGRES_PORT=5433
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking-dev-password
POSTGRES_DB=booking
# disable | require | verify-ca | verify-full
POSTGRES_SSLMODE=disable
# Integration tests use a SEPARATE database (created on demand, migrated
# by the tests themselves) so they never touch dev data. Override only if
# you need a different name; it must match [a-z0-9_]+.
TEST_POSTGRES_DB=booking_test

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# JWT signing secret. Generate one with: openssl rand -hex 32
# Must be at least 32 characters when ENV=production.
AUTH_JWT_SECRET=change-me-with-openssl-rand-hex-32
AUTH_ACCESS_TOKEN_TTL=15m
# 30 days
AUTH_REFRESH_TOKEN_TTL=720h

# -----------------------------------------------------------------------------
# RabbitMQ — BookingConfirmed events + outbox relay (CLAUDE.md §6, ADR 0009).
# -----------------------------------------------------------------------------
RABBITMQ_URL=amqp://booking:booking-dev-password@localhost:5672/booking
# Topology names. Both the publisher and the consumer declare the FULL
# topology (durable topic exchange + durable queue + binding) idempotently
# on every connect, so whoever starts first is right and a mismatch against
# a live broker fails loudly instead of silently forking the topology.
RABBITMQ_EXCHANGE=booking.events
RABBITMQ_QUEUE=booking.notifications
# Max unacked in-flight deliveries per consumer (Qos prefetch).
RABBITMQ_PREFETCH=10

# -----------------------------------------------------------------------------
# Worker (cmd/worker) — background job tuning.
# -----------------------------------------------------------------------------
# How often the outbox relay polls Postgres for unpublished events. Polling
# is deliberate (ADR 0009): stateless, restart-proof, and seconds of publish
# latency are invisible next to the 5-minute hold TTL.
WORKER_RELAY_POLL_INTERVAL=5s
# Max events published per relay pass (the SQL LIMIT).
WORKER_RELAY_BATCH_SIZE=100
# How often the hold-expiry sweeper reconciles the Redis bookkeeping ZSETs
# (ADR 0010). Holds live minutes, so half-a-minute granularity on slot
# reclaim is invisible to users.
WORKER_SWEEP_INTERVAL=30s
# Max expired holds reclaimed per sweep pass (the ZSET window size).
WORKER_SWEEP_BATCH_SIZE=500

# -----------------------------------------------------------------------------
# Payments (CLAUDE.md §7)
# -----------------------------------------------------------------------------
# fake   = deterministic in-process sandbox. Default for dev/CI; all automated
#          tests ALWAYS use this — a real gateway is never hit from tests.
# stripe = Stripe TEST mode against your own test keys (never live keys).
#          NOT IMPLEMENTED until the Stripe milestone (ADR 0008): the API
#          refuses to boot with provider=stripe.
PAYMENT_PROVIDER=fake
# HMAC secret the fake gateway signs/verifies webhook payloads with
# (Payment-Signature header, ADR 0008). Required when PAYMENT_PROVIDER=fake.
# Anyone holding it can forge captures — treat it like a real credential:
# never commit it, generate your own (openssl rand -hex 32).
PAYMENT_FAKE_WEBHOOK_SECRET=
PAYMENT_STRIPE_SECRET_KEY=
PAYMENT_STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Telemetry (OpenTelemetry)
# -----------------------------------------------------------------------------
# Disables tracing only; /metrics and log correlation by request ID remain.
OTEL_ENABLED=true
# otlp (OTLP/HTTP to Jaeger) | stdout (newline-delimited JSON spans)
OTEL_TRACES_EXPORTER=otlp
# Base URL, no credentials/query/path; exporter appends /v1/traces.
# Required when tracing is enabled with exporter=otlp (no address default).
# HTTP protocol uses 4318, NOT the gRPC port 4317. make up starts Jaeger.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Parent-based root sampling: 1 = all, 0 = no new root traces. A valid
# upstream sampled flag is honored. Metrics are never sampled.
OTEL_TRACE_SAMPLE_RATIO=1
# One bounded async batch export attempt; spans are best-effort, not durable.
OTEL_EXPORT_TIMEOUT=3s
# /metrics reads the Redis future-expiry index within this deadline. Failure
# omits booking_active_holds and reports collection_success=0, not zero holds.
METRICS_REDIS_TIMEOUT=1s
