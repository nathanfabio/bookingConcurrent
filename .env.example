# =============================================================================
# bookingConcurrent — environment configuration
#
# Copy to `.env` and adjust. NEVER commit real values (.gitignore excludes .env).
# Every variable here is loaded and VALIDATED at boot by internal/platform/config:
# the process refuses to start if anything required is missing or malformed —
# a broken process must never look like a healthy one (CLAUDE.md §10).
#
# The Makefile sources this file for `make run`, so keep it to plain
# KEY=value lines (no shell tricks, no inline comments on value lines).
# =============================================================================

# Deployment environment: development | production | test
#   development: human-readable logs, auto-migrations at boot
#   production:  JSON logs, stricter secret validation
#   test:        reserved for the test suite
ENV=development

# Name stamped on logs/traces/metrics so this service is findable in Jaeger.
SERVICE_NAME=booking-api

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
# How long to wait for in-flight requests to drain on SIGTERM/SIGINT
# before forcing the server closed (graceful shutdown, CLAUDE.md §5).
HTTP_SHUTDOWN_TIMEOUT=15s

# -----------------------------------------------------------------------------
# Logging: debug | info | warn | error
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Redis — TRANSIENT concurrency state only: seat holds (SET NX + TTL) and
# session reverse-lookup keys. Nothing durable may live here (see ADR 0003).
# -----------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# How long a seat hold lives before it expires on its own.
REDIS_HOLD_TTL=5m

# -----------------------------------------------------------------------------
# Booking policy
# -----------------------------------------------------------------------------
# Max seats one user may hold simultaneously. Enforced atomically inside the
# Redis hold script (a check-then-act from Go would be advisory under load).
MAX_ACTIVE_HOLDS=4

# -----------------------------------------------------------------------------
# PostgreSQL — the durable source of truth: users, movies, screenings,
# confirmed bookings, payments, outbox, refresh tokens, audit log.
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
# 5433: the compose stack maps its container to host port 5433 because a
# local host Postgres commonly owns 5432 already (see compose.yaml).
POSTGRES_PORT=5433
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking-dev-password
POSTGRES_DB=booking
# disable | require | verify-ca | verify-full
POSTGRES_SSLMODE=disable

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# JWT signing secret. Generate one with: openssl rand -hex 32
# Must be at least 32 characters when ENV=production.
AUTH_JWT_SECRET=change-me-with-openssl-rand-hex-32
AUTH_ACCESS_TOKEN_TTL=15m
# 30 days
AUTH_REFRESH_TOKEN_TTL=720h

# -----------------------------------------------------------------------------
# RabbitMQ — BookingConfirmed events + outbox relay (CLAUDE.md §6).
# -----------------------------------------------------------------------------
RABBITMQ_URL=amqp://booking:booking-dev-password@localhost:5672/booking

# -----------------------------------------------------------------------------
# Payments (CLAUDE.md §7)
# -----------------------------------------------------------------------------
# fake   = deterministic in-process sandbox. Default for dev/CI; all automated
#          tests ALWAYS use this — a real gateway is never hit from tests.
# stripe = Stripe TEST mode against your own test keys (never live keys).
PAYMENT_PROVIDER=fake
PAYMENT_STRIPE_SECRET_KEY=
PAYMENT_STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Telemetry (OpenTelemetry)
# -----------------------------------------------------------------------------
# Until M8, spans go to a console exporter; from M8 they go to Jaeger via OTLP.
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
